(version 1)
(rule "Class 2 fabrication minimums"
  (constraint clearance (min 0.10mm))
  (constraint track_width (min 0.15mm))
  (constraint via_diameter (min 0.40mm))
  (constraint hole_size (min 0.20mm))
  (constraint hole_clearance (min 0.10mm))
  (constraint hole_to_hole (min 0.20mm))
  (constraint edge_clearance (min 0.25mm))
)
